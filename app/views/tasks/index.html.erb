<div class="mb-8">
  <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">Todo List</h1>
  <p class="mt-2 text-gray-500">Stay organized, get things done.</p>
</div>

<%= turbo_frame_tag "task_form" do %>
  <%= form_with model: Task.new, url: tasks_path, class: "mb-8 flex gap-3" do |f| %>
    <div class="flex-1 relative">
      <%= f.text_field :title, placeholder: "What needs to be done?", autofocus: true,
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-gray-700 placeholder-gray-400 transition" %>
    </div>
    <%= f.submit "Add",
        class: "px-6 py-3 bg-gray-900 hover:bg-black text-white font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer active:scale-95" %>
  <% end %>
<% end %>

<% if @tasks.any? %>
  <div id="tasks" class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden divide-y divide-gray-100">
    <%= render @tasks %>
  </div>

  <div id="task_counts" class="mt-4 flex items-center justify-between text-sm text-gray-400 px-1">
    <span><%= @tasks.where(completed: false).count %> remaining</span>
    <span><%= @tasks.where(completed: true).count %> completed</span>
  </div>
<% else %>
  <div id="tasks" class="text-center py-16">
    <div class="text-6xl mb-4">&#9996;</div>
    <p class="text-gray-500 text-lg">No tasks yet. Add one above!</p>
  </div>
<% end %>
