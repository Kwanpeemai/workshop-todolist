<div class="mb-8">
  <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight">
    <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">Todo List</span>
  </h1>
  <p class="mt-2 text-gray-500">Stay organized, get things done.</p>
</div>

<%= form_with model: Task.new, url: tasks_path, class: "mb-8 flex gap-3" do |f| %>
  <div class="flex-1 relative">
    <%= f.text_field :title, placeholder: "What needs to be done?", autofocus: true,
        class: "w-full px-4 py-3 rounded-xl border border-gray-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-gray-700 placeholder-gray-400 transition" %>
  </div>
  <%= f.submit "Add",
      class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer active:scale-95" %>
<% end %>

<% if @tasks.any? %>
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden divide-y divide-gray-100">
    <% @tasks.each do |task| %>
      <div class="group flex items-center gap-4 px-5 py-4 hover:bg-gray-50/80 transition-colors duration-150 <%= 'opacity-60' if task.completed? %>">
        <%= form_with model: task, method: :patch, class: "flex items-center" do |f| %>
          <%= f.check_box :completed,
              onchange: "this.form.requestSubmit()",
              checked: task.completed?,
              class: "w-5 h-5 rounded-md border-2 border-gray-300 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-0 cursor-pointer transition" %>
        <% end %>

        <span class="flex-1 text-gray-800 font-medium <%= 'line-through text-gray-400' if task.completed? %>">
          <%= task.title %>
        </span>

        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to edit_task_path(task),
              class: "p-2 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
          <% end %>
          <%= button_to task_path(task), method: :delete,
              data: { turbo_confirm: "Delete this task?" },
              class: "p-2 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 flex items-center justify-between text-sm text-gray-400 px-1">
    <span><%= @tasks.where(completed: false).count %> remaining</span>
    <span><%= @tasks.where(completed: true).count %> completed</span>
  </div>
<% else %>
  <div class="text-center py-16">
    <div class="text-6xl mb-4">&#9996;</div>
    <p class="text-gray-500 text-lg">No tasks yet. Add one above!</p>
  </div>
<% end %>
