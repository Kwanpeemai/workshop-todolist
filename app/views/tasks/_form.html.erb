<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
  <%= form_with model: task do |f| %>
    <% if task.errors.any? %>
      <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% task.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= f.label :title, class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.text_field :title, autofocus: true,
          class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-gray-700 transition" %>
    </div>

    <div class="mb-8 flex items-center gap-3">
      <%= f.check_box :completed,
          class: "w-5 h-5 rounded-md border-2 border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" %>
      <%= f.label :completed, class: "text-sm font-medium text-gray-700 cursor-pointer" %>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer active:scale-95" %>
      <%= link_to "Cancel", tasks_path,
          class: "text-sm text-gray-500 hover:text-gray-700 transition-colors" %>
    </div>
  <% end %>
</div>
