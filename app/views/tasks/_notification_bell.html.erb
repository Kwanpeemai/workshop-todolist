<div class="relative" data-controller="notification" data-notification-tasks-value="<%= Task.active.where.not(due_date: nil).select(:id, :title, :due_date, :completed).map { |t| { title: t.title, due_date: t.due_date.to_s, completed: t.completed? } }.to_json %>">
  <button data-action="click->notification#toggle" class="relative p-2.5 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
    <span data-notification-target="badge" class="hidden absolute -top-1 -right-1 w-5 h-5 bg-coral-500 text-white text-xs font-bold rounded-full flex items-center justify-center">0</span>
  </button>
  <div data-notification-target="panel" class="hidden absolute right-0 top-12 w-72 sm:w-80 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden z-50">
    <div class="px-4 py-3 border-b border-gray-100 dark:border-gray-700">
      <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-200">Reminders</h3>
    </div>
    <div data-notification-target="list" class="max-h-64 overflow-y-auto"></div>
  </div>
</div>
