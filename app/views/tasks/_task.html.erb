<%= turbo_frame_tag task do %>
  <div id="<%= dom_id(task) %>" class="group flex items-center gap-3 px-5 py-4 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors duration-150 animate-slide-down <%= 'opacity-60' if task.completed? %>">
    <%# Drag handle %>
    <div data-sortable-handle class="cursor-grab active:cursor-grabbing text-gray-300 dark:text-gray-600 hover:text-gray-500 dark:hover:text-gray-400 transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>
    </div>

    <%# Checkbox %>
    <%= form_with model: task, method: :patch, class: "flex items-center" do |f| %>
      <%= f.check_box :completed,
          onchange: "this.form.requestSubmit()",
          checked: task.completed?,
          class: "w-5 h-5 rounded-md border-2 border-gray-300 dark:border-gray-600 text-forest-500 focus:ring-forest-400 focus:ring-offset-0 cursor-pointer transition dark:bg-gray-700" %>
    <% end %>

    <%# Title + meta %>
    <div class="flex-1 min-w-0">
      <span class="block text-gray-800 dark:text-gray-200 font-medium truncate <%= 'line-through text-gray-400 dark:text-gray-500' if task.completed? %>">
        <%= task.title %>
      </span>
      <div class="flex items-center gap-2 mt-1 flex-wrap">
        <% unless task.low? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold
            <%= task.high? ? 'bg-coral-100 text-coral-700 dark:bg-coral-900/30 dark:text-coral-400' : 'bg-primary-100 text-primary-700 dark:bg-primary-900/30 dark:text-primary-400' %>">
            <%= task.priority.capitalize %>
          </span>
        <% end %>
        <% if task.due_date.present? %>
          <span class="inline-flex items-center gap-1 text-xs
            <%= if task.overdue?
                  'text-coral-600 dark:text-coral-400 font-semibold'
                elsif task.due_soon?
                  'text-primary-600 dark:text-primary-400'
                else
                  'text-gray-400 dark:text-gray-500'
                end %>">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
            <%= task.due_date.strftime("%b %d") %>
            <%= " — Overdue!" if task.overdue? %>
          </span>
        <% end %>
        <% task.tags.each do |tag| %>
          <%= link_to tag.name, tasks_path(tag: tag.name),
              data: { turbo_action: "replace" },
              class: "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-forest-50 text-forest-600 dark:bg-forest-900/30 dark:text-forest-400 hover:bg-forest-100 dark:hover:bg-forest-900/50 transition" %>
        <% end %>
      </div>
    </div>

    <%# Actions %>
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <%= link_to edit_task_path(task),
          class: "p-2 rounded-lg text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
      <% end %>
      <%= button_to task_path(task), method: :delete,
          data: { turbo_confirm: "Delete this task?" },
          class: "p-2 rounded-lg text-gray-400 hover:text-coral-600 dark:hover:text-coral-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
      <% end %>
    </div>
  </div>
<% end %>
