<%= turbo_stream.remove "empty_state" %>

<%= turbo_stream.replace "tasks" do %>
  <div id="tasks" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden divide-y divide-gray-100 dark:divide-gray-700" data-controller="sortable">
    <%= render Task.order(:position) %>
  </div>
<% end %>

<%= turbo_stream.update "task_form" do %>
  <%= form_with model: Task.new, url: tasks_path, class: "mb-8 flex flex-wrap gap-3" do |f| %>
    <div class="flex-1 min-w-0">
      <%= f.text_field :title, placeholder: "What needs to be done?", autofocus: true,
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-gray-700 dark:text-gray-200 placeholder-gray-400 dark:placeholder-gray-500 transition" %>
    </div>
    <div class="flex gap-2">
      <%= f.select :priority, options_for_select([["Low", "low"], ["Medium", "medium"], ["High", "high"]], "low"),
          {}, class: "px-3 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer transition" %>
      <%= f.date_field :due_date,
          class: "px-3 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer transition" %>
    </div>
    <%= f.submit "Add",
        class: "px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer active:scale-95" %>
  <% end %>
<% end %>

<%= turbo_stream.replace "task_counts" do %>
  <div id="task_counts" class="mt-4 flex items-center justify-between text-sm text-gray-400 dark:text-gray-500 px-1">
    <span><%= Task.active.count %> remaining</span>
    <span><%= Task.done.count %> completed</span>
  </div>
<% end %>
