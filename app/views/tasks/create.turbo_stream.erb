<%= turbo_stream.prepend "tasks", @task %>

<%= turbo_stream.update "task_form" do %>
  <%= form_with model: Task.new, url: tasks_path, class: "mb-8 flex gap-3" do |f| %>
    <div class="flex-1 relative">
      <%= f.text_field :title, placeholder: "What needs to be done?", autofocus: true,
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-gray-700 placeholder-gray-400 transition" %>
    </div>
    <%= f.submit "Add",
        class: "px-6 py-3 bg-gray-900 hover:bg-black text-white font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer active:scale-95" %>
  <% end %>
<% end %>

<%= turbo_stream.update "task_counts" do %>
  <span><%= Task.where(completed: false).count %> remaining</span>
  <span><%= Task.where(completed: true).count %> completed</span>
<% end %>
